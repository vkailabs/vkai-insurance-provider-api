// VK AI Labs Insurance — Provider API data model.
// Postgres via Prisma. Table names are snake_case + plural per naming conventions.

generator client {
  provider      = "prisma-client-js"
  // native = host runs; the linux-musl targets cover the Alpine Docker image on
  // both Intel (amd64) and Apple Silicon (arm64) dev machines.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("VKAI_INSURANCE_PROVIDER_API_DATABASE_URL")
}

// Ops/provider-side users, upserted from Entra ID token claims on first login.
model OpsUser {
  id            String   @id @default(uuid()) @db.Uuid
  entraObjectId String   @unique @map("entra_object_id")
  email         String   @unique
  name          String?
  role          String // Reviewer | Approver
  createdAt     DateTime @default(now()) @map("created_at")

  reviewedClaims Claim[] @relation("ReviewedBy")
  approvedClaims Claim[] @relation("ApprovedBy")

  @@map("ops_users")
}

// Source of truth for insurance plans. The client side caches a read-only copy.
model PolicyCatalog {
  id             String   @id @default(uuid()) @db.Uuid
  // Short human-readable code derived from `name` on create (e.g. "PG2").
  // Unique across the catalog; IS synced to the client cache as of VKAI-002.
  key            String   @unique
  name           String
  description    String?
  premiumAmount  Decimal  @map("premium_amount") @db.Decimal(12, 2)
  coverageAmount Decimal  @map("coverage_amount") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  // Outbound-sync reliability trio (VKAI-003): a catalog create/edit is pushed to
  // the client cache; these track that push so the 5-min retry job can re-send.
  syncStatus     String   @default("pending") @map("sync_status") // pending | synced | failed
  syncAttempts   Int      @default(0) @map("sync_attempts")
  eventId        String?  @map("event_id") @db.Uuid

  policies Policy[]

  @@index([syncStatus])
  @@map("policy_catalog")
}

// Enrollment instances, mirrored from client-side events.
model Policy {
  id              String   @id @default(uuid()) @db.Uuid
  policyCatalogId String   @map("policy_catalog_id") @db.Uuid
  clientPolicyId  String   @unique @map("client_policy_id") @db.Uuid
  clientUserRef   String   @map("client_user_ref")
  status          String   @default("pending") // pending | active | expired
  enrolledAt      DateTime @map("enrolled_at")
  expiryDate      DateTime @map("expiry_date") @db.Date
  syncStatus      String   @default("pending") @map("sync_status") // pending | synced | failed
  syncAttempts    Int      @default(0) @map("sync_attempts")
  eventId         String?  @map("event_id") @db.Uuid

  policyCatalog PolicyCatalog @relation(fields: [policyCatalogId], references: [id])
  premiums      Premium[]
  claims        Claim[]

  @@index([status])
  @@index([syncStatus])
  @@map("policies")
}

// Premium payments, recorded passively from client-side pushes.
model Premium {
  id            String    @id @default(uuid()) @db.Uuid
  policyId      String    @map("policy_id") @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  paidAt        DateTime  @map("paid_at")
  // VKAI-009: enrolment date for this premium's plan, sourced from the client
  // premium-sync payload (`enrolled_at`). Nullable to stay backward-compatible
  // with premiums synced before this field existed; falls back to the linked
  // policy's enrolledAt on read/sync when absent.
  enrolmentDate DateTime? @map("enrolment_date")
  syncStatus    String    @default("synced") @map("sync_status") // pending | synced | failed
  syncAttempts  Int       @default(0) @map("sync_attempts")
  eventId       String?   @unique @map("event_id") @db.Uuid

  policy Policy @relation(fields: [policyId], references: [id])

  @@index([syncStatus])
  @@map("premiums")
}

// Claims, mirrored from client-side and worked by ops.
model Claim {
  id            String   @id @default(uuid()) @db.Uuid
  policyId      String   @map("policy_id") @db.Uuid
  clientClaimId String   @unique @map("client_claim_id") @db.Uuid
  amountClaimed Decimal  @map("amount_claimed") @db.Decimal(12, 2)
  description   String
  status        String   @default("Submitted") // Submitted | Under Review | Approved | Rejected | Paid
  reviewedById  String?  @map("reviewed_by") @db.Uuid
  approvedById  String?  @map("approved_by") @db.Uuid
  submittedAt   DateTime @map("submitted_at")
  syncStatus    String   @default("pending") @map("sync_status") // pending | synced | failed
  syncAttempts  Int      @default(0) @map("sync_attempts")
  eventId       String?  @map("event_id") @db.Uuid

  policy     Policy   @relation(fields: [policyId], references: [id])
  reviewedBy OpsUser? @relation("ReviewedBy", fields: [reviewedById], references: [id])
  approvedBy OpsUser? @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([status])
  @@index([syncStatus])
  @@map("claims")
}
