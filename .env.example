# --- VK AI Labs Insurance Provider API — local dev environment ---
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# HTTP port the API listens on.
VKAI_INSURANCE_PROVIDER_API_PORT=4100

# Postgres connection string. Host port is 5433 (not 5432) to avoid clashing
# with the client-api's Postgres container when both stacks run on one machine.
# When running the API inside docker-compose, the compose file overrides the host
# with the `postgres` service name; this value is for running the API on the host.
VKAI_INSURANCE_PROVIDER_API_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vkai_insurance_provider_dev

# --- Entra ID (Azure AD) — real values required before ops login will work ---
VKAI_INSURANCE_PROVIDER_API_ENTRA_TENANT_ID=
VKAI_INSURANCE_PROVIDER_API_ENTRA_CLIENT_ID=
VKAI_INSURANCE_PROVIDER_API_ENTRA_REVIEWER_GROUP_ID=
VKAI_INSURANCE_PROVIDER_API_ENTRA_APPROVER_GROUP_ID=

# Shared secret for cross-cloud sync routes (X-VKAI-Sync-Key header).
VKAI_INSURANCE_PROVIDER_API_SYNC_KEY=

# Base URL of the client-side (GCP) API this provider pushes status updates to.
VKAI_INSURANCE_CLIENT_API_BASE_URL=http://localhost:4000

# CORS: origin allowed to call this API (the provider frontend dev server).
VKAI_INSURANCE_PROVIDER_API_ALLOWED_ORIGIN=http://localhost:5174

# Log level: trace | debug | info | warn | error | fatal
VKAI_INSURANCE_PROVIDER_API_LOG_LEVEL=info

# Node environment (development | production). Optional; defaults to development.
NODE_ENV=development
